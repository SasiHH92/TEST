# Másold .env néven (discord-bot/.env). A .env SOHA nem kerül Gitbe.

# Developer Portal → Bot → Reset Token. TITKOS: ne oszd meg, ne commitold.
DISCORD_BOT_TOKEN=

# Developer Portal → General Information → Application ID (nem titok)
DISCORD_CLIENT_ID=

# Opcionális: ha megadod, a bot csak ezen a szerveren fogad parancsot
# (Discord: Fejlesztői mód → jobb klikk a szerverre → Szerver-azonosító másolása)
DISCORD_GUILD_ID=

# A játék címe – ez kerül a „játék-kereső” és „üdvözlünk” embedekbe
KAMU_GAME_URL=https://test-1-ndkt.onrender.com

# --- Kamu Bíróság backend összekötés (tárgyalások, jelentkezés, szerepek) ---
# A játék webes címe (https, a végén perjel nélkül) – a bot ide kapcsolódik
BACKEND_URL=https://test-1-ndkt.onrender.com
# Közös titok: UGYANAZT kell megadni a Render webszolgáltatás Environment fülén is (BOT_SERVICE_TOKEN).
# Generálás: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   – legalább 32 karakter, TITKOS
BOT_SERVICE_TOKEN=

# --- Moderáció (opcionális) ---
# 1 = bekapcsolva. ELŐTTE a Developer Portalon: Bot fül → Privileged Gateway Intents → MESSAGE CONTENT INTENT = BE (különben a bot moderáció nélkül indul).
# A meghívó linket is frissíteni kell (npm run invite): új jogok: Manage Messages, Moderate Members.
MODERATION=0
# off = a káromkodás megengedett (a gyűlöletbeszéd, spam, átverés ettől még tiltott)
MOD_PROFANITY=delete
# MI-alapú szöveg- és képértelmezés (Anthropic Claude). Alapból KI; költséggel jár, a vizsgált tartalom az Anthropic API-hoz kerül.
MOD_AI=0
ANTHROPIC_API_KEY=
MOD_AI_MODEL=claude-haiku-5-5
# new = csak az 1 hétnél frissebb tagok szövegét értékeli | all = mindenkiét | off = csak képeket
MOD_AI_TEXT=new
# Saját szólista (JSON: {"hate":[],"profanity":[],"allow":[]}; a '*' végű szó tő, pl. "kurva*")
MOD_WORDLIST_FILE=
