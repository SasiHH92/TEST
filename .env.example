# Másold .env néven. Az üres Google/Discord beállítások mellett az
# e-mail/jelszavas regisztráció és belépés önállóan működik.
AUTH_BASE_URL=http://localhost:3000
AUTH_STORE_PATH=data/accounts.json

# Google Cloud: OAuth 2.0 Client ID, Web application.
# Redirect URI: http://localhost:3000/api/auth/google/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Discord Developer Portal: OAuth2, Redirects.
# Redirect URI: http://localhost:3000/api/auth/discord/callback
AUTH_DISCORD_CLIENT_ID=
AUTH_DISCORD_CLIENT_SECRET=

# Jelszó-visszaállító levél: Resend API-kulcs és hitelesített feladó.
AUTH_MAIL_API_KEY=
AUTH_MAIL_FROM=

# Tartós tárolás külső Postgres adatbázisban: a DATABASE_URL-t a Render Environment fülén add meg
# (környezeti változóként; a .env-ből csak az AUTH_ sorok töltődnek be). Lásd TAROLAS.md.

# Csak megbízható reverse proxy (például Render) mögött legyen 1.
AUTH_TRUST_PROXY=0
