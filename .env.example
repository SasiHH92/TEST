# Másold .env néven. Az üres Google/Discord beállítások mellett az
# e-mail/jelszavas regisztráció és belépés önállóan működik.
AUTH_BASE_URL=http://localhost:3000
AUTH_STORE_PATH=data/accounts.json

# Google Cloud: OAuth 2.0 Client ID, Web application.
# Redirect URI: http://localhost:3000/api/auth/google/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Discord Developer Portal: OAuth2, Redirects.
# Redirect URI: http://localhost:3000/api/auth/discord/callback
AUTH_DISCORD_CLIENT_ID=
AUTH_DISCORD_CLIENT_SECRET=

# E-mailek (Resend): megerősítő, üdvözlő, jelszó-visszaállító, jelszóváltozás, játékmeghívó, biztonsági értesítő. Lásd EMAIL_BEALLITAS.md.
# Az API-kulcs csak a szerveren él (a böngészőbe soha nem kerül). Kulcs, feladó ÉS AUTH_BASE_URL kell a levélküldéshez.
RESEND_API_KEY=
EMAIL_FROM="Kamu Bíróság <noreply@kamubirosag.com>"
# (nem kötelező) a levelek fejléc-képe: https cím, 600 px széles kép; nélküle szöveges fejléc van
EMAIL_HEADER_IMAGE_URL=
# (nem kötelező) Discord-meghívó a levelek láblécében
# DISCORD_INVITE_URL=https://discord.gg/yyG7hH4aEB
# Fejlesztéshez: 1 esetén NEM megy ki levél, a tartalom a konzolra és az EMAIL_OUTBOX_FILE fájlba kerül (éles szerveren NE állítsd be!)
# EMAIL_DRY_RUN=1
# EMAIL_OUTBOX_FILE=data/outbox.jsonl
# Az új regisztrációk e-mail-megerősítése (alapból be van kapcsolva, ha működik a levélküldés); 0 = kikapcsolva
# AUTH_REQUIRE_EMAIL_VERIFICATION=0
# (a régi AUTH_MAIL_API_KEY / AUTH_MAIL_FROM nevek is működnek)

# Tartós tárolás külső Postgres adatbázisban: a DATABASE_URL-t a Render Environment fülén add meg
# (környezeti változóként; a .env-ből csak az AUTH_ sorok töltődnek be). Lásd TAROLAS.md.

# Csak megbízható reverse proxy (például Render) mögött legyen 1.
AUTH_TRUST_PROXY=0

# Az alábbiak NEM a .env-ből, hanem környezeti változóból jönnek (Renderen: Environment fül; helyben: $env:NEV = '...'):
#   ADMIN_TOKEN     – /admin oldal (hibanapló, mentések, levélpróba); legalább 24 véletlen karakter, nélküle az oldal ki van kapcsolva
#   LEGEND_SECRET   – a legendás kártyák igénylő-linkjeihez (legalább 16 karakter)
#   DATABASE_URL    – külső Postgres (Neon), lásd TAROLAS.md
#   TESTER_POGACSA  – a legendás (tesztelő) fiókok egyszeri pogácsa-jutalma (alapból 5000; 0 = kikapcsolva)
#   BOT_SERVICE_TOKEN – a Discord bot és a szerver közös titka (≥ 32 karakter); nélküle a Discord-integráció ki van kapcsolva, lásd DISCORD_OSSZEKOTES.md

# Jogi oldalak (impresszum, adatkezelés, felhasználási feltételek): az üzemeltetői adatok. Lásd LEGAL_BEALLITAS.md. A kötelezők nélkül az oldalak "kitöltendő" jelzést mutatnak.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
# LEGAL_OPERATOR_KIND=magánszemély
# LEGAL_OPERATOR_COUNTRY=AT
# LEGAL_OPERATOR_PHONE=
# LEGAL_OPERATOR_REGNO=
# LEGAL_MIN_AGE=16
# LEGAL_RENDER_REGION=Frankfurt (EU)
# LEGAL_NEON_REGION=Frankfurt (EU)
# A regisztráció feltételeinek elfogadása: élesen (https) alapból kötelező; 1 = mindig, 0 = soha
# AUTH_REQUIRE_TERMS=1
